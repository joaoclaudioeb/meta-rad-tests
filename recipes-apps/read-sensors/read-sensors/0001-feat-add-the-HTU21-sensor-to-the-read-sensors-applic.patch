diff --git a/src/htu21.cpp b/src/htu21.cpp
new file mode 100644
index 0000000..88d7174
--- /dev/null
+++ b/src/htu21.cpp
@@ -0,0 +1,76 @@
+#include <iio.h>
+
+#include <fsatutils/log/log.hpp>
+#include <memory>
+#include <read-sensors/htu21.hpp>
+#include <read-sensors/sensor.hpp>
+#include <stdexcept>
+#include <string>
+
+namespace sensor {
+
+Htu21::Htu21(std::shared_ptr<fsatutils::iio::Context> ctx, std::string name) {
+  supported_types_ = {"humidity", "temperature"};
+  name_ = name;
+  channel_based_ = false;
+
+  dev_ = std::make_unique<fsatutils::iio::Device>(ctx, name);
+  hum_ = std::make_unique<fsatutils::iio::Channel>("humidityrelative0", *dev_,
+                                                   false);
+  temp_ = std::make_unique<fsatutils::iio::Channel>("temp0", *dev_, false);
+}
+
+std::optional<std::vector<SensorDataEntry>> Htu21::read() {
+  std::vector<SensorDataEntry> readings;
+
+  auto entry = this->get_temperature();
+  if (entry) readings.push_back(*entry);
+
+  entry = this->get_humidity();
+  if (entry) readings.push_back(*entry);
+
+  if (readings.empty()) return std::nullopt;
+  return readings;
+}
+
+std::optional<sensor::SensorDataEntry> Htu21::get_temperature() const {
+  long long raw_value;
+
+  try {
+    raw_value = temp_->read_attr<long long>("input");
+  } catch (std::runtime_error const& e) {
+    logs::log(ERR, "Failed to read temperature input attr!\n");
+    return std::nullopt;
+  }
+
+  double temperature = static_cast<double>(raw_value) / 1000.0;
+
+  return sensor::SensorDataEntry{
+      .sensorName = name_,
+      .sensorType = "htu21",
+      .measurementType = "temperature",
+      .value = temperature,
+  };
+}
+
+std::optional<sensor::SensorDataEntry> Htu21::get_humidity() const {
+  long long raw_value;
+
+  try {
+    raw_value = hum_->read_attr<long long>("input");
+  } catch (std::runtime_error const& e) {
+    logs::log(ERR, "Failed to read humidity input attr!\n");
+    return std::nullopt;
+  }
+
+  double humidity = static_cast<double>(raw_value) / 1000.0;
+
+  return sensor::SensorDataEntry{
+      .sensorName = name_,
+      .sensorType = "htu21",
+      .measurementType = "humidity",
+      .value = humidity,
+  };
+}
+
+}  // namespace sensor
