/dts-v1/;
/plugin/;

&spi0 {
    num-cs = <4>;
    is-decoded-cs = <1>;

    spi0_dev0: spidev@0 {
        compatible = "rohm,dh2228fv";
        reg = <0>;
        spi-max-frequency = <1000000>;
        status = "okay";
    };

    spi0_dev1: spidev@1 {
        compatible = "rohm,dh2228fv";
        reg = <1>;
        spi-max-frequency = <1000000>;
        status = "okay";
    };

    spi0_dev2: spidev@2 {
        compatible = "rohm,dh2228fv";
        reg = <2>;
        spi-max-frequency = <1000000>;
        status = "okay";
    };

    spi0_dev3: spidev@3 {
        compatible = "rohm,dh2228fv";
        reg = <3>;
        spi-max-frequency = <1000000>;
        status = "okay";
    };
};

&axi_iic_0 {
    status = "okay";
	clock-frequency = <100000>;
    #address-cells = <1>;
    #size-cells = <0>;

    htu21@40 {
        compatible = "meas,htu21";
        reg = <0x40>;
        label = "htu21";
    };
};
